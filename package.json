{
  "name": "tree-sitter-vba",
  "version": "0.13.0",
  "description": "Tree-sitter grammar for Visual Basic for Applications (VBA).",
  "keywords": [
    "excel",
    "excel-vba",
    "grammar",
    "parser",
    "tree-sitter",
    "tree-sitter-grammar",
    "vba",
    "visual-basic",
    "visual-basic-for-applications"
  ],
  "homepage": "https://github.com/harumiWeb/tree-sitter-vba#readme",
  "bugs": {
    "url": "https://github.com/harumiWeb/tree-sitter-vba/issues"
  },
  "license": "MIT",
  "author": "harumiWeb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harumiWeb/tree-sitter-vba.git"
  },
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/*",
    "bindings/go/*.go",
    "src/**",
    "queries/*",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "install": "node scripts/install.mjs",
    "generate": "tree-sitter generate --abi 15",
    "prepack": "pnpm generate",
    "build:binding": "node-gyp rebuild",
    "build:wasm": "pnpm generate && node scripts/build-wasm.mjs",
    "build:playground": "pnpm generate && node scripts/build-playground.mjs",
    "test:corpus": "pnpm generate && node scripts/run-tree-sitter.mjs test",
    "test:stress": "pnpm generate && node scripts/ensure-binding.mjs && node scripts/stress-select-case.mjs",
    "test": "pnpm test:corpus && pnpm test:stress",
    "test:binding": "node scripts/ensure-binding.mjs && node --test bindings/node/*_test.js",
    "parse:examples": "node scripts/parse-examples.mjs",
    "test:third-party": "node --test test/third-party-licenses.test.mjs",
    "check:third-party": "node scripts/check-third-party-licenses.mjs",
    "query:examples": "node scripts/query-examples.mjs",
    "check:go-parser": "node scripts/check-go-parser-artifact.mjs",
    "bench": "node scripts/ensure-binding.mjs && node scripts/bench.mjs",
    "test:wasm": "pnpm build:wasm && node --test test/wasm/wasm.test.mjs",
    "test:parity": "pnpm generate && node scripts/ensure-binding.mjs && node scripts/build-wasm.mjs && node --test test/parity/parser-parity.test.mjs",
    "test:playground": "pnpm build:playground && node --test test/playground/playground.test.mjs",
    "build:browser-consumer": "pnpm build:wasm && node scripts/build-browser-consumer.mjs build/wasm/tree-sitter-vba.wasm",
    "check:browser-artifact": "node scripts/check-browser-artifact-contract.mjs",
    "test:browser-consumer:node": "node --test test/browser-consumer/browser-consumer.test.mjs",
    "test:browser-consumer:browser": "node --test test/browser-consumer/browser-smoke.test.mjs",
    "test:browser-consumer": "pnpm build:browser-consumer && pnpm test:browser-consumer:node && pnpm test:browser-consumer:browser",
    "fmt": "oxfmt",
    "check": "pnpm test && pnpm test:third-party && pnpm check:third-party && pnpm check:browser-artifact && pnpm check:go-parser && pnpm test:binding && pnpm parse:examples && pnpm query:examples && pnpm test:wasm && pnpm test:parity && pnpm test:playground && pnpm test:browser-consumer"
  },
  "dependencies": {
    "node-addon-api": "^8.8.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "esbuild": "0.28.1",
    "oxfmt": "^0.54.0",
    "playwright": "1.62.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.26.9",
    "web-tree-sitter": "0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.28.1"
}
